{
  "name": "@opengaming/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK and CLI for Open Gaming ATProto Achievements, Leaderboards, Inline Attestations, and Revocations",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "opengaming": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test src/__tests__/*.test.ts",
    "validate": "tsx src/cli.ts validate"
  },
  "dependencies": {
    "@atproto/api": "^0.15.0",
    "@atproto/crypto": "^0.4.0",
    "@atproto/identity": "^0.4.0",
    "@atproto/lexicon": "^0.4.0",
    "@ipld/dag-cbor": "^9.2.1",
    "multiformats": "^13.3.1",
    "uint8arrays": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "license": "CC0-1.0"
}
